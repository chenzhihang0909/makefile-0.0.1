{
  "name": "wing-makefile",
  "displayName": "wing-makefile",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:c"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "c-mk-auto-generator.generateMk",
        "title": "Generate mk"
      },
      {
        "command": "c-mk-auto-generator.removeMk",
        "title": "Remove mk"
      },
      {
        "command": "c-sort-objs.panelView",
        "title": "Link Order"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "c-mk-auto-generator.generateMk",
          "when": "explorerResourceIsFolder",
          "group": "mk-group@1"
        },
        {
          "command": "c-sort-objs.panelView",
          "when": "explorerResourceIsFolder",
          "group": "mk-group@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "yarn run compile-tests && yarn run compile && yarn run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.17",
    "@types/vscode": "^1.110.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "axios": "^1.17.0"
  }
}
